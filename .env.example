# Local-only defaults. Copy to .env; never commit real credentials.
POSTGRES_DB=vessel_caller
POSTGRES_USER=vessel_caller
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
REDIS_PORT=6379

VC_ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=vessel_caller.settings.development
VC_SECRET_KEY=local-development-secret-change-me
VC_ALLOWED_HOSTS=localhost,127.0.0.1
VC_CSRF_TRUSTED_ORIGINS=http://localhost:5173
VC_DATABASE_URL=postgresql://vessel_caller:local-development-only@127.0.0.1:5432/vessel_caller
VC_REDIS_URL=redis://127.0.0.1:6379/0
VC_FRONTEND_URL=http://localhost:5173

# Optional integrations stay disabled unless real sandbox credentials are set.
VC_RESEND_API_KEY=
VC_EMAIL_FROM=
VC_SPACES_KEY=
VC_SPACES_SECRET=
VC_SPACES_BUCKET=
VC_SPACES_REGION=
VC_SPACES_ENDPOINT_URL=
VC_SENTRY_DSN=
VC_MFA_ENCRYPTION_KEY=
VC_LOG_LEVEL=INFO
