# Copy to .env.local for local development. Production values belong in the
# Droplet's protected environment file, never in Git.
DJANGO_SETTINGS_MODULE=vessel_caller.settings.development
VC_ENVIRONMENT=development
VC_DEBUG=true

# Required in production. Use a PostgreSQL role scoped to one database and
# require TLS (`?sslmode=require`) for managed databases.
VC_DATABASE_URL=postgresql://vessel_caller:replace-me@127.0.0.1:5432/vessel_caller
VC_TEST_DATABASE_URL=postgresql://vessel_caller_test:replace-me@127.0.0.1:5432/vessel_caller_test
VC_REDIS_URL=redis://127.0.0.1:6379/0

# Generate at least 48 random bytes. VC_MFA_ENCRYPTION_KEY must remain stable
# because it encrypts TOTP seeds at rest.
VC_SECRET_KEY=
VC_MFA_ENCRYPTION_KEY=
VC_ALLOWED_HOSTS=localhost,127.0.0.1
VC_CSRF_TRUSTED_ORIGINS=http://localhost:5173
VC_FRONTEND_URL=http://localhost:5173
VC_SESSION_COOKIE_SECURE=false
VC_SECURE_SSL_REDIRECT=false

# Transactional identity email. Set backend=resend in staging/production;
# console and memory are safe development/test backends.
VC_EMAIL_DELIVERY_BACKEND=console
# Production defaults this to false.  Set it to true only alongside a live,
# qualified Resend configuration when public onboarding is approved.
VC_PUBLIC_REGISTRATION_ENABLED=true
VC_RESEND_API_KEY=
VC_EMAIL_FROM=Vessel Caller <noreply@vesselcalls.com>

# Private DigitalOcean Spaces object storage.
VC_SPACES_KEY=
VC_SPACES_SECRET=
VC_SPACES_BUCKET=
VC_SPACES_REGION=nyc3
VC_SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com

# Release identity and error monitoring contain no secrets in responses.
VC_RELEASE_SHA=development
VC_RELEASE_TAG=
VC_SENTRY_DSN=
VC_SENTRY_TRACES_SAMPLE_RATE=0.05
VC_LOG_LEVEL=INFO
