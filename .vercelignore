# What NOT to upload to Vercel. (Vercel reads this, not .gitignore.)
# The deploy = frontend/ (built to dist) + api/ (Python function) + backend/ (imported by the function).
.git
.gitignore
.claude
*.log
.DS_Store
.vercel

# Python venv + local databases
.venv
backend/.venv
*.db
*.db-*
backend/tests

# Node — Vercel installs deps itself
node_modules
frontend/dist

# Legacy single-repo prototype (superseded by frontend/ + backend/; not served).
# Leading "/" anchors to the repo root so these DON'T match nested frontend/ files
# (e.g. a bare "mobile" would wrongly exclude frontend/src/mobile/).
/index.html
/app.html
/Mobile Data Capture.html
/calabar
/mobile
/vendor
/server.py
/serve.sh
