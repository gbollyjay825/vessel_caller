[Unit]
Description=Prepare Vessel Caller release (staging)
After=network-online.target redis-vessel-caller-staging.service
Wants=network-online.target
AssertPathExists=/opt/vessel-caller/slots/staging/current/backend/manage.py
AssertPathExists=/etc/vessel-caller/staging.env
AssertPathExists=/etc/vessel-caller/staging-e2e.env
AssertPathExists=/opt/vessel-caller/slots/staging/current/RELEASE.env

[Service]
Type=oneshot
RemainAfterExit=yes
User=vessel-caller-staging
Group=vessel-caller-staging
WorkingDirectory=/opt/vessel-caller/slots/staging/current/backend
EnvironmentFile=/etc/vessel-caller/staging.env
EnvironmentFile=/etc/vessel-caller/staging-e2e.env
EnvironmentFile=/opt/vessel-caller/slots/staging/current/RELEASE.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/local/lib/vessel-caller/staging-compatibility-guard.sh
ExecStart=/opt/vessel-caller/slots/staging/current/backend/.venv/bin/python manage.py check --deploy --fail-level WARNING
ExecStart=/opt/vessel-caller/slots/staging/current/backend/.venv/bin/python manage.py migrate --noinput
ExecStart=/opt/vessel-caller/slots/staging/current/backend/.venv/bin/python manage.py collectstatic --noinput --clear
ExecStart=/opt/vessel-caller/slots/staging/current/backend/.venv/bin/python manage.py seed_e2e --force
TimeoutStartSec=300
UMask=0027

StateDirectory=vessel-caller/staging
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/vessel-caller/staging /opt/vessel-caller/releases
