# Vessel Caller API — environment. Copy to `.env` and adjust. All vars are
# prefixed VC_. Only VC_JWT_SECRET and VC_CORS_ORIGINS must change for prod.

VC_ENVIRONMENT=development                 # development | production

# Storage. SQLite by default; for Postgres use e.g.
#   postgresql+psycopg://user:pass@host:5432/vessel
VC_DATABASE_URL=sqlite:///./vessel_caller.db

# Auth — MUST be a long random string in production (>= 32 bytes). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VC_JWT_SECRET=change-me-to-a-long-random-string
VC_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of allowed frontend origins (the Vite app).
VC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed demo data (org + team + 12 months of history) when the DB is empty.
VC_SEED_ON_STARTUP=true
